# Copy this file to .env for local development.
HOST=127.0.0.1
PORT=3000
COOKIE_SECURE=0

# Paths are relative to the repository unless absolute.
DB_PATH=data/knowpilot.db
UPLOAD_DIR=data/uploads
DATA_ROOT=data/datasets
HF_HOME=.cache/huggingface
CODE_ROOTS=

# Fill both fields before the first startup to create an administrator.
KNOWPILOT_ADMIN_USER=
KNOWPILOT_ADMIN_PASSWORD=

# Optional. Without a key, model-assisted features are unavailable.
DEEPSEEK_API_KEY=
MODEL_BASE_URL=
MODEL_CHAT=deepseek-flash
MODEL_REASONER=deepseek-v4-pro

# Local semantic retrieval is available after downloading the model weights.
EMBED_MODEL_ID=bge-m3
EMBED_DTYPE=q8
KNOWPILOT_RERANK_ENABLED=0
